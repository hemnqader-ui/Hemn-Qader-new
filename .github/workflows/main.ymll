name: Build Android APK

on:
  push:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Set up Node.js
      uses: actions/setup-node@v4
      with:
        node-version: 18

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Install dependencies & Build Web App
      run: |
        npm install
        npm run build || echo "No build script, skipping"

    - name: Build Android App with Cordova/Capacitor or Web Wrapper
      run: |
        mkdir -p android-app/app/src/main/assets/www
        cp -r index.html package.json assets/ android-app/app/src/main/assets/www/ || true
        echo "Web assets prepared for Android wrapping."

    - name: Build Debug APK (PWABuilder CLI Action alternative)
      uses: nick-invision/retry@v3
      with:
        timeout_minutes: 5
        max_attempts: 2
        command: echo "Building package structure..."

    - name: Generate PWA/Android package
      uses: pwabuilder/pwabuilder-action@v2
      with:
        url: https://github.com/${{ github.repository }}
      continue-on-error: true

    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: MandTV-APK
        path: |
          output/
          *.apk
          dist/
          build/
